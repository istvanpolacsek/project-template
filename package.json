{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "ci:check": "pnpm format:check && nx run-many -t lint typecheck test build",
    "test:tools": "node --test \".claude/**/*.test.mjs\" \".github/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "bootstrap": "node scripts/bootstrap.mjs",
    "env:check": "node scripts/check-env.mjs"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "~5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "nx": "24.0.6",
    "prettier": "^3.10.1",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "~5.0.5"
  },
  "packageManager": "pnpm@11.2.2",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": "prettier --write"
  },
  "engines": {
    "node": ">=24"
  }
}
